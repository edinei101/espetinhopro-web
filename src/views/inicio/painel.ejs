<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EspetinhoPro - <%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card-kpi {
      border-radius: 12px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .btn-acao-rapida {
      padding: 1.2rem 1.5rem;
      font-size: 1.1rem;
      font-weight: 700;
      border-radius: 12px;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
  </style>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <div class="d-flex">
    <%- include('../partials/_sidebar') %>

    <main class="flex-grow-1 p-4">
      <!-- Cabeçalho -->
      <div class="mb-4 pb-3 border-bottom">
        <h2 class="fw-bold mb-1 text-dark">Painel Inicial</h2>
        <div class="mb-2">
          <span class="badge bg-secondary">
            <i class="fa-solid fa-user-tie me-1"></i> Gerente: <%= dados.nomeOperador %>
          </span>
        </div>
        <h4 class="text-dark fw-bold mb-1">
          Bem-vindo ao EspetinhoPro, <%= dados.nomeOperador %>!
        </h4>
        <p class="text-muted small mb-0">Visão geral da sua operação em tempo real.</p>
      </div>

      <!-- 3 Cards do Resumo -->
      <div class="row g-4 mb-4">
        <!-- 1. Mesas Livres -->
        <div class="col-12 col-md-4">
          <div class="card card-kpi border-0 bg-white p-4 border-top border-success border-4">
            <span class="text-muted fw-bold text-uppercase small">Mesas Livres</span>
            <h2 class="fw-bold my-2 text-success">
              <%= dados.mesasLivres %> <span class="fs-5 text-muted fw-normal">/ <%= dados.totalMesas %></span>
            </h2>
          </div>
        </div>

        <!-- 2. Mesas Ocupadas -->
        <div class="col-12 col-md-4">
          <div class="card card-kpi border-0 bg-white p-4 border-top border-danger border-4">
            <span class="text-muted fw-bold text-uppercase small">Mesas Ocupadas</span>
            <h2 class="fw-bold my-2 text-danger">
              <%= dados.mesasOcupadas %>
            </h2>
          </div>
        </div>

        <!-- 3. Clientes no Balcão -->
        <div class="col-12 col-md-4">
          <div class="card card-kpi border-0 bg-white p-4 border-top border-primary border-4">
            <span class="text-muted fw-bold text-uppercase small">Clientes no Balcão</span>
            <h2 class="fw-bold my-2 text-primary">
              <%= dados.clientesBalcao %>
            </h2>
          </div>
        </div>
      </div>

      <!-- 2 Botões de Ação Rápida -->
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <a href="/mesas" class="btn btn-warning btn-acao-rapida text-dark w-100 shadow-sm">
            <i class="fa-solid fa-utensils"></i>
            Acessar Salão de Mesas
          </a>
        </div>

        <div class="col-12 col-md-6">
          <a href="/balcao" class="btn btn-primary btn-acao-rapida text-white w-100 shadow-sm">
            <i class="fa-solid fa-cash-register"></i>
            Venda Avulsa no Balcão
          </a>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>