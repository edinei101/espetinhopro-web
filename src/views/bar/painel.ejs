<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EspetinhoPro - <%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card-kds {
      border-radius: 12px;
      transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    .card-kds:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08) !important;
    }
    .card-kds.preparando {
      border-top: 5px solid #0dcaf0 !important;
    }
    .card-kds.pendente {
      border-top: 5px solid #0d6efd !important;
    }
  </style>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <div class="d-flex">
    <%- include('../partials/_sidebar') %>

    <main class="flex-grow-1 p-4">
      <!-- Topo: Título do Bar e Contadores -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
          <h2 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-beer-mug-empty text-primary me-2"></i>Bar / Bebidas
          </h2>
          <small class="text-muted">Fila de separação de cervejas, refrigerantes e drinks</small>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
            <%= pedidos.filter(p => p.status_preparo === 'PENDENTE').length %> A Separar
          </span>
          <span class="badge bg-info text-dark fs-6 px-3 py-2 shadow-sm">
            <%= pedidos.filter(p => p.status_preparo === 'EM_PREPARO').length %> Em Atendimento
          </span>
          <button class="btn btn-outline-secondary btn-sm ms-2" onclick="window.location.reload();" title="Atualizar agora">
            <i class="fa-solid fa-rotate me-1"></i> Atualizar
          </button>
        </div>
      </div>

      <!-- Fila de Pedidos de Bebidas em Cards -->
      <div class="row g-4">
        <% if (pedidos.length === 0) { %>
          <div class="col-12 text-center py-5">
            <div class="p-5 rounded-4 bg-white shadow-sm border">
              <i class="fa-solid fa-champagne-glasses text-primary fa-4x mb-3"></i>
              <h3 class="fw-bold text-dark">Nenhum pedido de bebida pendente!</h3>
              <p class="text-muted mb-0">Todas as bebidas foram entregues aos clientes.</p>
            </div>
          </div>
        <% } %>

        <% pedidos.forEach(p => { %>
          <div class="col-12 col-md-6 col-lg-4 col-xl-3">
            <div class="card card-kds h-100 shadow-sm border-0 bg-white d-flex flex-column justify-content-between <%= p.status_preparo === 'EM_PREPARO' ? 'preparando' : 'pendente' %>">
              
              <!-- Cabeçalho do Card -->
              <div class="p-3 border-bottom bg-light rounded-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge <%= p.status_preparo === 'EM_PREPARO' ? 'bg-info text-dark' : 'bg-primary' %> fw-bold">
                    <%= p.status_preparo === 'EM_PREPARO' ? 'SEPARANDO' : 'PENDENTE' %>
                  </span>
                  <span class="badge bg-secondary-subtle text-dark border">
                    Pedido #<%= p.pedido_id %>
                  </span>
                </div>

                <div class="d-flex justify-content-between align-items-baseline">
                  <h4 class="fw-bold text-dark mb-0">
                    <% if (p.comanda_tipo === 'MESA') { %>
                      <i class="fa-solid fa-chair text-danger me-1"></i> Mesa <%= p.mesa_numero %>
                    <% } else { %>
                      <i class="fa-solid fa-cash-register text-primary me-1"></i> Balcão
                    <% } %>
                  </h4>
                  <small class="text-primary fw-bold">
                    <i class="fa-regular fa-clock me-1"></i>
                    <%= new Date(p.data_criacao).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
                  </small>
                </div>

                <small class="text-muted d-block mt-1">
                  Cliente: <strong class="text-dark"><%= p.nome_cliente || 'Avulso' %></strong>
                  <% if (p.garcom_nome) { %> | Atendente: <%= p.garcom_nome %><% } %>
                </small>
              </div>

              <!-- Lista de Bebidas -->
              <div class="p-3 flex-grow-1">
                <ul class="list-unstyled mb-0">
                  <% p.itens.forEach(item => { %>
                    <li class="mb-3 pb-2 border-bottom">
                      <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-bold text-dark fs-5">
                          <span class="text-primary"><%= item.quantidade %>x</span> <%= item.produto_nome %>
                        </span>
                      </div>

                      <% if (item.observacao) { %>
                        <div class="text-secondary small mt-1">
                          <i class="fa-solid fa-comment-dots text-primary me-1"></i><strong>Obs:</strong> <%= item.observacao %>
                        </div>
                      <% } %>
                    </li>
                  <% }) %>
                </ul>
              </div>

              <!-- Ações do Bartender -->
              <div class="p-3 border-top bg-light rounded-bottom">
                <% if (p.status_preparo === 'PENDENTE') { %>
                  <form action="/bar/pedido/<%= p.pedido_id %>/iniciar" method="POST">
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
                      <i class="fa-solid fa-bottle-water me-1"></i> Iniciar Separação
                    </button>
                  </form>
                <% } else if (p.status_preparo === 'EM_PREPARO') { %>
                  <form action="/bar/pedido/<%= p.pedido_id %>/concluir" method="POST">
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2 shadow-sm">
                      <i class="fa-solid fa-check-double me-1"></i> Marcar como Entregue
                    </button>
                  </form>
                <% } %>
              </div>

            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Atualização automática a cada 15 segundos -->
  <script>
    setTimeout(function() {
      window.location.reload();
    }, 15000);
  </script>
</body>
</html>