<%- include('partials/header') %>

<h2>🔥 Painel da Grelha</h2>

<% if (error) { %>
  <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
    <%= error %>
  </div>
<% } %>

<ul>
  <% if (itensGrelha && itensGrelha.length > 0) { %>
    <% itensGrelha.forEach(item => { %>
      <li><%= item.espetinho ? item.espetinho.nome : 'Item' %> - Ponto: <%= item.pontoCarne %></li>
    <% }) %>
  <% } else { %>
    <li>Nenhum pedido pendente na grelha.</li>
  <% } %>
</ul>

<%- include('partials/footer') %>