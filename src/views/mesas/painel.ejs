<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EspetinhoPro - <%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card-mesa {
      transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
      cursor: pointer;
      border-radius: 12px;
    }
    .card-mesa:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 16px rgba(0,0,0,0.08) !important;
    }
  </style>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <div class="d-flex">
    <%- include('../partials/_sidebar') %>

    <main class="flex-grow-1 p-4">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
          <h2 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-utensils text-warning me-2"></i>Salão de Mesas</h2>
          <small class="text-muted">Clique em uma mesa livre para abrir ou em uma ocupada para ver/lançar pedidos</small>
        </div>
      </div>

      <div class="row g-3">
        <% if (mesas.length === 0) { %>
          <div class="col-12 text-center py-5">
            <i class="fa-solid fa-chair text-muted fa-3x mb-3"></i>
            <p class="text-muted">Nenhuma mesa cadastrada no sistema.</p>
          </div>
        <% } %>

        <% mesas.forEach(mesa => { %>
          <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <% if (mesa.status === 'OCUPADA' && mesa.comanda_id) { %>
              <!-- Mesa Ocupada: Link direto para a comanda -->
              <a href="/mesas/comanda/<%= mesa.comanda_id %>" class="text-decoration-none">
                <div class="card card-mesa h-100 shadow-sm border-0 border-top border-danger border-4 bg-white">
                  <div class="card-body p-3 text-center">
                    <span class="badge bg-danger mb-2">OCUPADA</span>
                    <h4 class="card-title fw-bold text-dark mb-1">Mesa <%= mesa.numero %></h4>
                    
                    <div class="mt-2 pt-2 border-top">
                      <p class="mb-0 text-muted small text-truncate fw-bold">
                        <i class="fa-solid fa-user me-1"></i><%= mesa.cliente || 'Cliente' %>
                      </p>
                      <h5 class="text-danger fw-bold my-1">
                        R$ <%= Number(mesa.total).toFixed(2).replace('.', ',') %>
                      </h5>
                      <span class="btn btn-outline-danger btn-sm w-100 fw-bold mt-1" style="font-size: 0.75rem;">
                        Ver Pedidos
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            <% } else { %>
              <!-- Mesa Livre: Botão que aciona modal de abertura -->
              <div 
                class="card card-mesa h-100 shadow-sm border-0 border-top border-success border-4 bg-white"
                onclick="abrirModalMesa('<%= mesa.id %>', '<%= mesa.numero %>')"
              >
                <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
                  <div>
                    <span class="badge bg-success mb-2">LIVRE</span>
                    <h4 class="card-title fw-bold text-dark mb-1">Mesa <%= mesa.numero %></h4>
                    <% if (mesa.nome_identificador) { %>
                      <p class="text-muted small mb-0"><%= mesa.nome_identificador %></p>
                    <% } %>
                  </div>
                  <div class="mt-3">
                    <button class="btn btn-outline-success btn-sm w-100 fw-bold" style="font-size: 0.75rem;">
                      <i class="fa-solid fa-plus me-1"></i> Ocupar Mesa
                    </button>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </main>
  </div>

  <!-- Modal para Ocupar Mesa -->
  <div class="modal fade" id="modalOcuparMesa" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form action="/mesas/abrir" method="POST">
          <input type="hidden" name="mesa_id" id="modal_mesa_id">
          <div class="modal-header bg-success text-white">
            <h5 class="modal-title fw-bold">
              <i class="fa-solid fa-chair me-2"></i>Abrir Atendimento - <span id="modal_mesa_numero"></span>
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <label for="nome_cliente" class="form-label fw-bold">Identificação do Cliente / Responsável:</label>
            <input 
              type="text" 
              class="form-control form-control-lg" 
              id="nome_cliente" 
              name="nome_cliente" 
              placeholder="Ex: Família Silva, Carlos..." 
              required
            >
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success fw-bold px-4">
              <i class="fa-solid fa-check me-1"></i> Iniciar Mesa
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const modalOcupar = new bootstrap.Modal(document.getElementById('modalOcuparMesa'));

    function abrirModalMesa(id, numero) {
      document.getElementById('modal_mesa_id').value = id;
      document.getElementById('modal_mesa_numero').innerText = 'Mesa ' + numero;
      document.getElementById('nome_cliente').value = '';
      modalOcupar.show();
      setTimeout(() => document.getElementById('nome_cliente').focus(), 400);
    }
  </script>
</body>
</html>