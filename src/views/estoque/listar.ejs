<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EspetinhoPro - <%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card-estoque { border-radius: 12px; }
    .pulse-danger {
      animation: pulseAlert 1.8s infinite;
    }
    @keyframes pulseAlert {
      0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
      70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
      100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
  </style>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <div class="d-flex">
    <%- include('../partials/_sidebar') %>

    <main class="flex-grow-1 p-4">
      <!-- Mensagens de Feedback -->
      <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i><%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-2"></i><%= erro %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Topo: Título e Botão de Cadastro -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
          <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-boxes-stacked text-warning me-2"></i>Controle de Estoque
          </h2>
          <small class="text-muted">Gerenciamento de produtos, saldo físico e alerta preventivo para compras</small>
        </div>
        <button class="btn btn-warning fw-bold px-4 py-2 shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalNovoProduto">
          <i class="fa-solid fa-plus-circle fa-lg"></i>
          <span>Cadastrar Produto</span>
        </button>
      </div>

      <!-- BANNER DE ALERTA: ITENS COM ESTOQUE BAIXO / LIMITE MÍNIMO -->
      <% if (produtosAlerta.length > 0) { %>
        <div class="alert alert-danger border-danger shadow-sm p-4 rounded-4 mb-4 pulse-danger">
          <div class="d-flex align-items-center gap-3 mb-2">
            <i class="fa-solid fa-triangle-exclamation fa-2x text-danger"></i>
            <div>
              <h5 class="fw-bold mb-0 text-danger">Atenção Gerência: <%= produtosAlerta.length %> produto(s) com estoque em nível crítico!</h5>
              <small class="text-dark">Os seguintes itens atingiram ou estão abaixo do estoque mínimo configurado e precisam de reposição:</small>
            </div>
          </div>
          <div class="row g-2 mt-2">
            <% produtosAlerta.forEach(pa => { %>
              <div class="col-12 col-md-6 col-lg-4">
                <div class="p-2 bg-white rounded border border-danger d-flex justify-content-between align-items-center">
                  <div>
                    <strong class="text-dark d-block"><%= pa.nome %></strong>
                    <small class="text-muted">Mínimo definido: <%= pa.estoque_minimo %> un.</small>
                  </div>
                  <span class="badge bg-danger fs-6 px-3 py-2">
                    <%= pa.quantidade_estoque %> un. em estoque
                  </span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Tabela de Produtos em Estoque -->
      <div class="card card-estoque shadow-sm border-0 bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-list me-2 text-secondary"></i>Catálogo de Produtos (<%= produtos.length %>)
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small text-uppercase">
                <tr>
                  <th class="ps-3">Produto</th>
                  <th>Categoria</th>
                  <th class="text-end">Preço Venda</th>
                  <th class="text-center">Estoque Atual</th>
                  <th class="text-center">Estoque Mínimo</th>
                  <th class="text-center">Status</th>
                  <th class="text-end pe-3">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (produtos.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                      <i class="fa-solid fa-box-open fa-3x mb-2 text-secondary"></i>
                      <p class="mb-0">Nenhum produto cadastrado no estoque.</p>
                    </td>
                  </tr>
                <% } else { %>
                  <% produtos.forEach(p => { 
                    const nivelCritico = p.controla_estoque === 1 && p.estoque_minimo > 0 && p.quantidade_estoque <= p.estoque_minimo;
                  %>
                    <tr class="<%= nivelCritico ? 'table-danger-subtle' : '' %>">
                      <td class="ps-3">
                        <strong class="d-block text-dark"><%= p.nome %></strong>
                        <% if (p.descricao) { %>
                          <small class="text-muted"><%= p.descricao %></small>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= p.categoria_nome || 'Geral' %></span>
                      </td>
                      <td class="text-end fw-semibold">
                        R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %>
                      </td>
                      <td class="text-center">
                        <span class="badge <%= nivelCritico ? 'bg-danger' : 'bg-success' %> fs-6 px-3 py-2">
                          <%= p.quantidade_estoque %> un.
                        </span>
                      </td>
                      <td class="text-center">
                        <% if (p.estoque_minimo > 0) { %>
                          <span class="badge bg-secondary px-2 py-1"><%= p.estoque_minimo %> un.</span>
                        <% } else { %>
                          <small class="text-muted">Sem alerta</small>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <% if (nivelCritico) { %>
                          <span class="badge bg-danger text-white"><i class="fa-solid fa-triangle-exclamation me-1"></i>Repor Estoque</span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success border border-success">Normal</span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3">
                        <div class="btn-group">
                          <!-- Botão Movimentar Saldo (+ / -) -->
                          <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalMovimentar_<%= p.id %>" title="Lançar Entrada / Saída">
                            <i class="fa-solid fa-right-left"></i>
                          </button>
                          <!-- Botão Editar -->
                          <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditar_<%= p.id %>" title="Editar Produto">
                            <i class="fa-solid fa-pen-to-square"></i>
                          </button>
                          <!-- Botão Excluir -->
                          <form action="/estoque/<%= p.id %>/excluir" method="POST" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este produto?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Excluir Produto">
                              <i class="fa-solid fa-trash"></i>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>

                    <!-- MODAL DE MOVIMENTAÇÃO RÁPIDA DE ENTRADA/SAÍDA -->
                    <div class="modal fade" id="modalMovimentar_<%= p.id %>" tabindex="-1">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                          <form action="/estoque/<%= p.id %>/movimentar" method="POST">
                            <div class="modal-header bg-primary text-white">
                              <h5 class="modal-title fw-bold">
                                <i class="fa-solid fa-right-left me-2"></i>Movimentar: <%= p.nome %>
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                              <div class="p-3 bg-light rounded text-center mb-3 border">
                                <small class="text-muted text-uppercase fw-bold d-block">Saldo Físico Atual</small>
                                <h3 class="fw-bold text-dark mb-0"><%= p.quantidade_estoque %> un.</h3>
                              </div>

                              <div class="mb-3">
                                <label class="form-label fw-bold">Tipo de Movimentação:</label>
                                <select name="tipo_movimentacao" class="form-select form-select-lg fw-bold" required>
                                  <option value="ENTRADA" selected>➕ Entrada de Mercadoria (Compra)</option>
                                  <option value="SAIDA">➖ Saída Manual</option>
                                  <option value="PERDA">⚠️ Perda / Avaria</option>
                                  <option value="AJUSTE">🔄 Balanço / Ajuste Contado</option>
                                </select>
                              </div>

                              <div class="mb-3">
                                <label class="form-label fw-bold">Quantidade:</label>
                                <input type="number" name="quantidade" class="form-control form-control-lg text-center fw-bold" min="1" value="1" required>
                              </div>

                              <div class="mb-3">
                                <label class="form-label fw-bold">Motivo / Observação:</label>
                                <input type="text" name="motivo" class="form-control" placeholder="Ex: Compra NF 1234, reposição..." required>
                              </div>
                            </div>
                            <div class="modal-footer bg-light">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                              <button type="submit" class="btn btn-primary fw-bold px-4">Salvar Movimentação</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                    <!-- MODAL DE EDIÇÃO -->
                    <div class="modal fade" id="modalEditar_<%= p.id %>" tabindex="-1">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                          <form action="/estoque/<%= p.id %>/editar" method="POST">
                            <div class="modal-header bg-dark text-white">
                              <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Editar Produto</h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                              <div class="mb-3">
                                <label class="form-label fw-bold">Nome do Produto:</label>
                                <input type="text" name="nome" class="form-control" value="<%= p.nome %>" required>
                              </div>

                              <div class="row g-2 mb-3">
                                <div class="col-6">
                                  <label class="form-label fw-bold">Categoria:</label>
                                  <select name="categoria_id" class="form-select" required>
                                    <% categorias.forEach(c => { %>
                                      <option value="<%= c.id %>" <%= p.categoria_id === c.id ? 'selected' : '' %>>
                                        <%= c.nome %>
                                      </option>
                                    <% }) %>
                                  </select>
                                </div>
                                <div class="col-6">
                                  <label class="form-label fw-bold">Preço de Venda (R$):</label>
                                  <input type="number" step="0.01" name="preco" class="form-control" value="<%= Number(p.preco).toFixed(2) %>" required>
                                </div>
                              </div>

                              <div class="p-3 bg-warning-subtle border border-warning rounded mb-3">
                                <label class="form-label fw-bold text-dark d-block">
                                  <i class="fa-solid fa-bell me-1 text-warning-emphasis"></i>Estoque Mínimo (Alerta de Compra):
                                </label>
                                <input type="number" name="estoque_minimo" class="form-control form-control-lg text-center fw-bold" value="<%= p.estoque_minimo || 0 %>" min="0" required>
                                <small class="text-muted d-block mt-1">O sistema alertará no topo da tela quando o saldo for menor ou igual a esse valor.</small>
                              </div>

                              <div class="mb-3">
                                <label class="form-label fw-bold">Descrição (Opcional):</label>
                                <textarea name="descricao" class="form-control" rows="2"><%= p.descricao || '' %></textarea>
                              </div>
                            </div>
                            <div class="modal-footer bg-light">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                              <button type="submit" class="btn btn-dark fw-bold px-4">Atualizar Produto</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- MODAL DE CADASTRO DE NOVO PRODUTO -->
  <div class="modal fade" id="modalNovoProduto" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form action="/estoque/novo" method="POST">
          <div class="modal-header bg-warning text-dark">
            <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2"></i>Novo Produto no Estoque</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold">Nome do Produto:</label>
              <input type="text" name="nome" class="form-control" placeholder="Ex: Cerveja Heineken 330ml, Espeto de Picanha..." required>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label fw-bold">Categoria:</label>
                <select name="categoria_id" class="form-select" required>
                  <option value="" disabled selected>Selecione...</option>
                  <% categorias.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.nome %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label fw-bold">Preço Venda (R$):</label>
                <input type="number" step="0.01" min="0" name="preco" class="form-control" placeholder="0.00" required>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label fw-bold">Quantidade Inicial:</label>
                <input type="number" min="0" name="quantidade_estoque" class="form-control form-control-lg text-center fw-bold" value="0" required>
              </div>
              <div class="col-6">
                <label class="form-label fw-bold text-danger">Estoque Mínimo (Alerta):</label>
                <input type="number" min="0" name="estoque_minimo" class="form-control form-control-lg text-center fw-bold border-danger text-danger" value="10" required>
              </div>
            </div>

            <div class="alert alert-light border small text-muted mb-3">
              <i class="fa-solid fa-circle-info text-primary me-1"></i>
              Quando o saldo deste produto chegar a <strong>10</strong> (ou ao valor que você configurar), o sistema exibirá o alerta para compra no topo da tela.
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold">Descrição / Detalhes:</label>
              <textarea name="descricao" class="form-control" rows="2" placeholder="Marca, fornecedor ou detalhes"></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-warning fw-bold px-4">Salvar no Estoque</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>