<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Produção - <%= setor %></title>
  <style>
    @page {
      margin: 0;
      size: 80mm auto;
    }
    body {
      font-family: 'Courier New', Courier, monospace;
      width: 76mm;
      margin: 0 auto;
      padding: 3mm;
      color: #000;
      background: #fff;
      font-size: 13px;
      line-height: 1.3;
    }
    .text-center { text-align: center; }
    .bold { font-weight: bold; }
    .divider {
      border-top: 2px dashed #000;
      margin: 6px 0;
    }
    .destaque-setor {
      font-size: 20px;
      font-weight: bold;
      border: 2px solid #000;
      padding: 4px;
      margin: 4px 0;
    }
    .destaque-mesa {
      font-size: 24px;
      font-weight: 900;
      margin: 4px 0;
    }
    .item-box {
      margin: 8px 0;
      padding-bottom: 6px;
      border-bottom: 1px dotted #555;
    }
    .item-titulo {
      font-size: 16px;
      font-weight: bold;
    }
    .item-obs {
      font-size: 13px;
      font-style: italic;
      margin-left: 10px;
      background: #f0f0f0;
      padding: 2px 4px;
    }
    .no-print {
      margin-bottom: 10px;
      text-align: center;
    }
    .btn-imprimir {
      background: #000;
      color: #fff;
      padding: 8px 16px;
      border: none;
      font-weight: bold;
      cursor: pointer;
      border-radius: 4px;
    }
    @media print {
      .no-print { display: none; }
    }
  </style>
</head>
<body onload="window.print()">

  <div class="no-print">
    <button class="btn-imprimir" onclick="window.print()">🖨️ IMPRIMIR ORDEM</button>
  </div>

  <div class="text-center">
    <div class="destaque-setor">>>> <%= setor %> <<<</div>
    <div class="destaque-mesa">
      <% if (comanda.tipo === 'BALCAO' || !comanda.mesa_numero) { %>
        BALCÃO #<%= comanda.id %>
      <% } else { %>
        MESA <%= comanda.mesa_numero %>
      <% } %>
    </div>
    <div>Atendente: <%= comanda.atendente_nome || 'Equipe' %></div>
    <div>Hora: <%= dataEmissao %></div>
  </div>

  <div class="divider"></div>

  <% if (itens.length === 0) { %>
    <div class="text-center">Nenhum item deste setor.</div>
  <% } else { %>
    <% itens.forEach(item => { %>
      <div class="item-box">
        <div class="item-titulo">
          [ <%= item.quantidade %>x ] <%= item.produto_nome %>
        </div>
        <% if (item.ponto_carne) { %>
          <div class="item-obs">🔥 PONTO: <%= item.ponto_carne.toUpperCase() %></div>
        <% } %>
        <% if (item.observacao) { %>
          <div class="item-obs">⚠️ OBS: <%= item.observacao %></div>
        <% } %>
      </div>
    <% }) %>
  <% } %>

  <div class="divider"></div>
  <div class="text-center bold">ORDEM DE PRODUÇÃO</div>

</body>
</html>