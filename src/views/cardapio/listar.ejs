<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EspetinhoPro - <%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card-cardapio { border-radius: 12px; }
  </style>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <div class="d-flex">
    <%- include('../partials/_sidebar') %>

    <main class="flex-grow-1 p-4">
      <!-- Mensagens de Alerta -->
      <% if (typeof mensagem !== 'undefined' && mensagem) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i><%= mensagem %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-2"></i><%= erro %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Topo: Título e Botão de Novo Item -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
          <h2 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-book-open text-danger me-2"></i>Gestão de Cardápio
          </h2>
          <small class="text-muted">Cadastro de produtos, preços, acompanhamentos padrão e visibilidade</small>
        </div>
        <button class="btn btn-danger fw-bold px-4 py-2 shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalNovoItem">
          <i class="fa-solid fa-plus-circle fa-lg"></i>
          <span>Novo Item no Cardápio</span>
        </button>
      </div>

      <!-- Abas de Navegação por Categorias -->
      <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
          <a class="nav-link fw-bold px-4 <%= categoriaAtiva === 1 ? 'active bg-danger text-white' : 'btn-outline-secondary text-dark border' %>" href="/cardapio?categoria=1">
            <i class="fa-solid fa-fire me-2"></i>1. Espetinhos & Carnes
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-bold px-4 <%= categoriaAtiva === 2 ? 'active bg-danger text-white' : 'btn-outline-secondary text-dark border' %>" href="/cardapio?categoria=2">
            <i class="fa-solid fa-bowl-rice me-2"></i>2. Acompanhamentos
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-bold px-4 <%= categoriaAtiva === 3 ? 'active bg-danger text-white' : 'btn-outline-secondary text-dark border' %>" href="/cardapio?categoria=3">
            <i class="fa-solid fa-wine-glass me-2"></i>3. Bebidas
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-bold px-4 <%= categoriaAtiva === 4 ? 'active bg-danger text-white' : 'btn-outline-secondary text-dark border' %>" href="/cardapio?categoria=4">
            <i class="fa-solid fa-candy-cane me-2"></i>4. Doces / Caixa
          </a>
        </li>
      </ul>

      <!-- Tabela de Itens da Categoria Ativa -->
      <div class="card card-cardapio shadow-sm border-0 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            Itens Cadastrados (<%= produtos.length %>)
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small text-uppercase">
                <tr>
                  <th class="ps-3">Item</th>
                  <th class="text-end">Preço</th>
                  <% if (categoriaAtiva === 1) { %>
                    <th>Acompanhamentos Padrão</th>
                    <th class="text-center">Ponto Carne?</th>
                  <% } %>
                  <th class="text-center">Controle Estoque</th>
                  <th class="text-end pe-3">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (produtos.length === 0) { %>
                  <tr>
                    <td colspan="<%= categoriaAtiva === 1 ? 6 : 4 %>" class="text-center py-5 text-muted">
                      <i class="fa-solid fa-utensils fa-3x mb-2 text-secondary"></i>
                      <p class="mb-0">Nenhum item cadastrado nesta categoria.</p>
                    </td>
                  </tr>
                <% } else { %>
                  <% produtos.forEach(p => { %>
                    <tr>
                      <td class="ps-3">
                        <strong class="d-block text-dark"><%= p.nome %></strong>
                        <% if (p.descricao) { %>
                          <small class="text-muted"><%= p.descricao %></small>
                        <% } %>
                      </td>
                      <td class="text-end fw-bold text-success">
                        R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %>
                      </td>
                      <% if (categoriaAtiva === 1) { %>
                        <td>
                          <% if (p.acompanhamentos && p.acompanhamentos.length > 0) { %>
                            <% p.acompanhamentos.forEach(a => { %>
                              <span class="badge bg-warning-subtle text-dark border border-warning me-1">
                                <%= a.nome %>
                              </span>
                            <% }) %>
                          <% } else { %>
                            <span class="text-muted small">Sem acompanhamentos</span>
                          <% } %>
                        </td>
                        <td class="text-center">
                          <% if (p.requer_ponto_carne === 1) { %>
                            <span class="badge bg-success-subtle text-success border border-success">Sim</span>
                          <% } else { %>
                            <span class="text-muted small">Não</span>
                          <% } %>
                        </td>
                      <% } %>
                      <td class="text-center">
                        <% if (p.controla_estoque === 1) { %>
                          <span class="badge bg-info-subtle text-info-emphasis border border-info">
                            <%= p.quantidade_estoque %> un.
                          </span>
                        <% } else { %>
                          <span class="text-muted small">Livre</span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3">
                        <div class="btn-group">
                          <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditar_<%= p.id %>" title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                          </button>
                          <form action="/cardapio/<%= p.id %>/excluir?categoria=<%= categoriaAtiva %>" method="POST" class="d-inline" onsubmit="return confirm('Excluir este item do cardápio?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Excluir">
                              <i class="fa-solid fa-trash"></i>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>

                    <!-- MODAL DE EDIÇÃO -->
                    <div class="modal fade" id="modalEditar_<%= p.id %>" tabindex="-1">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                          <form action="/cardapio/<%= p.id %>/editar" method="POST">
                            <input type="hidden" name="categoria_id" value="<%= categoriaAtiva %>">

                            <div class="modal-header bg-dark text-white">
                              <h5 class="modal-title fw-bold">
                                <i class="fa-solid fa-pen-to-square me-2"></i>Editar Item
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                              <div class="mb-3">
                                <label class="form-label fw-bold">Nome do Item:</label>
                                <input type="text" name="nome" class="form-control" value="<%= p.nome %>" required>
                              </div>

                              <div class="mb-3">
                                <label class="form-label fw-bold">Preço (R$):</label>
                                <input type="number" step="0.01" min="0" name="preco" class="form-control" value="<%= Number(p.preco).toFixed(2) %>" required>
                              </div>

                              <% if (categoriaAtiva === 1) { %>
                                <div class="form-check form-switch mb-3">
                                  <input class="form-check-input" type="checkbox" name="requer_ponto_carne" id="ed_ponto_<%= p.id %>" value="1" <%= p.requer_ponto_carne === 1 ? 'checked' : '' %>>
                                  <label class="form-check-label fw-bold" for="ed_ponto_<%= p.id %>">
                                    Exigir Ponto da Carne ao Lançar Pedido
                                  </label>
                                </div>

                                <div class="mb-3">
                                  <label class="form-label fw-bold border-bottom pb-1 d-block text-secondary">
                                    Acompanhamentos Padrão Deste Espetinho:
                                  </label>
                                  <div class="row g-2 p-2 bg-light rounded border">
                                    <% todosAcompanhamentos.forEach(acomp => { 
                                      const jaTem = p.acompanhamentos && p.acompanhamentos.some(a => a.id === acomp.id);
                                    %>
                                      <div class="col-6">
                                        <div class="form-check">
                                          <input class="form-check-input" type="checkbox" name="acompanhamentos" value="<%= acomp.id %>" id="ed_acomp_<%= p.id %>_<%= acomp.id %>" <%= jaTem ? 'checked' : '' %>>
                                          <label class="form-check-label small" for="ed_acomp_<%= p.id %>_<%= acomp.id %>">
                                            <%= acomp.nome %>
                                          </label>
                                        </div>
                                      </div>
                                    <% }) %>
                                  </div>
                                </div>
                              <% } %>

                              <div class="mb-3">
                                <label class="form-label fw-bold">Descrição:</label>
                                <textarea name="descricao" class="form-control" rows="2"><%= p.descricao || '' %></textarea>
                              </div>
                            </div>
                            <div class="modal-footer bg-light">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                              <button type="submit" class="btn btn-dark fw-bold px-4">Salvar Alterações</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- MODAL DE CADASTRO NOVO ITEM -->
  <div class="modal fade" id="modalNovoItem" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form action="/cardapio/novo" method="POST">
          <input type="hidden" name="categoria_id" value="<%= categoriaAtiva %>">

          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold">
              <i class="fa-solid fa-plus-circle me-2"></i>Novo Item no Cardápio
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold">Nome do Produto:</label>
              <input type="text" name="nome" class="form-control" placeholder="Ex: Espeto de Alcatra, Mandioca Cozida, Coca-cola..." required>
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold">Preço de Venda (R$):</label>
              <input type="number" step="0.01" min="0" name="preco" class="form-control" placeholder="0.00" required>
            </div>

            <% if (categoriaAtiva === 1) { %>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="requer_ponto_carne" id="nv_ponto" value="1" checked>
                <label class="form-check-label fw-bold" for="nv_ponto">
                  Exigir Ponto da Carne ao Lançar Pedido
                </label>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold border-bottom pb-1 d-block text-secondary">
                  Acompanhamentos Padrão deste Espetinho:
                </label>
                <div class="row g-2 p-2 bg-light rounded border">
                  <% todosAcompanhamentos.forEach(acomp => { %>
                    <div class="col-6">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="acompanhamentos" value="<%= acomp.id %>" id="nv_acomp_<%= acomp.id %>">
                        <label class="form-check-label small" for="nv_acomp_<%= acomp.id %>">
                          <%= acomp.nome %>
                        </label>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <div class="mb-3">
              <label class="form-label fw-bold">Descrição:</label>
              <textarea name="descricao" class="form-control" rows="2" placeholder="Ingredientes ou observações"></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-danger fw-bold px-4">Cadastrar Item</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>