<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Pré-Conta #<%= comanda.id %></title>
  <style>
    @page {
      margin: 0;
      size: 80mm auto;
    }
    body {
      font-family: 'Courier New', Courier, monospace;
      width: 76mm;
      margin: 0 auto;
      padding: 3mm;
      color: #000;
      background: #fff;
      font-size: 12px;
      line-height: 1.25;
    }
    .text-center { text-align: center; }
    .text-end { text-align: right; }
    .bold { font-weight: bold; }
    .divider {
      border-top: 1px dashed #000;
      margin: 6px 0;
    }
    .titulo-loja {
      font-size: 16px;
      font-weight: bold;
      letter-spacing: 1px;
    }
    .identificacao {
      font-size: 14px;
      font-weight: bold;
      margin: 4px 0;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
    }
    th, td {
      padding: 2px 0;
    }
    .totais-row {
      display: flex;
      justify-content: space-between;
      margin: 2px 0;
    }
    .total-destaque {
      font-size: 15px;
      font-weight: bold;
      border-top: 1px solid #000;
      border-bottom: 1px solid #000;
      padding: 4px 0;
      margin-top: 4px;
    }
    .no-print {
      margin-bottom: 10px;
      text-align: center;
    }
    .btn-imprimir {
      background: #000;
      color: #fff;
      padding: 8px 16px;
      border: none;
      font-weight: bold;
      cursor: pointer;
      border-radius: 4px;
    }
    @media print {
      .no-print { display: none; }
    }
  </style>
</head>
<body onload="window.print()">

  <div class="no-print">
    <button class="btn-imprimir" onclick="window.print()">🖨️ IMPRIMIR CONFERÊNCIA</button>
  </div>

  <div class="text-center">
    <div class="titulo-loja">ESPETINHOPRO</div>
    <div>Espetos, Porções & Bebidas</div>
    <div class="divider"></div>
    <div class="identificacao">
      <% if (comanda.tipo === 'BALCAO' || !comanda.mesa_numero) { %>
        COMANDA BALCÃO #<%= comanda.id %>
      <% } else { %>
        MESA <%= comanda.mesa_numero %> (Comanda #<%= comanda.id %>)
      <% } %>
    </div>
    <div>Atendente: <%= comanda.atendente_nome || 'Equipe' %></div>
    <div>Emissão: <%= dataEmissao %></div>
  </div>

  <div class="divider"></div>

  <table>
    <thead>
      <tr>
        <th style="text-align: left;">Qtd Item</th>
        <th class="text-end">Unit</th>
        <th class="text-end">Total</th>
      </tr>
    </thead>
    <tbody>
      <% itens.forEach(item => { %>
        <tr>
          <td style="text-align: left;">
            <%= item.quantidade %>x <%= item.produto_nome %>
            <% if (item.ponto_carne) { %> (<%= item.ponto_carne %>)<% } %>
          </td>
          <td class="text-end"><%= Number(item.preco_unitario).toFixed(2).replace('.', ',') %></td>
          <td class="text-end"><%= Number(item.valor_total).toFixed(2).replace('.', ',') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="divider"></div>

  <div class="totais-row">
    <span>Subtotal dos Produtos:</span>
    <span class="bold">R$ <%= subtotal.toFixed(2).replace('.', ',') %></span>
  </div>

  <% if (desconto > 0) { %>
    <div class="totais-row">
      <span>Desconto:</span>
      <span class="bold">- R$ <%= desconto.toFixed(2).replace('.', ',') %></span>
    </div>
  <% } %>

  <div class="totais-row">
    <span>Taxa de Serviço (10% sugerida):</span>
    <span>R$ <%= taxaServico.toFixed(2).replace('.', ',') %></span>
  </div>

  <div class="totais-row total-destaque">
    <span>TOTAL COM TAXA (10%):</span>
    <span>R$ <%= totalComTaxa.toFixed(2).replace('.', ',') %></span>
  </div>

  <div class="totais-row" style="margin-top: 4px; font-size: 11px;">
    <span>Total sem taxa:</span>
    <span>R$ <%= totalSemTaxa.toFixed(2).replace('.', ',') %></span>
  </div>

  <div class="divider"></div>

  <div class="text-center" style="font-size: 10px; margin-top: 6px;">
    *** CONFERÊNCIA DE MESA ***<br>
    NÃO É DOCUMENTO FISCAL<br>
    A taxa de serviço de 10% é opcional.<br>
    Agradecemos a preferência!
  </div>

</body>
</html>